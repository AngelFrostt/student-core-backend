# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Moscow

# --- CORS / CSRF (через запятую) ---
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth cookies ---
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=False
# AUTH_COOKIE_DOMAIN=.example.com

# --- Email ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Student Core <noreply@studentcore.local>
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True

# --- Production hardening ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
